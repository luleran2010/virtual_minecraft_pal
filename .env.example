# Langflow
LANGFLOW_BASE_URL=http://127.0.0.1:7860
LANGFLOW_FLOW_ID=your-langflow-flow-id
LANGFLOW_API_KEY=
LANGFLOW_TIMEOUT_MS=60000

# Minecraft
MINECRAFT_HOST=localhost
MINECRAFT_PORT=25565
MINECRAFT_USERNAME=VirtualPal
MINECRAFT_AUTH=offline

# MCP HTTP endpoint (binds to loopback by default)
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3001
MCP_HTTP_TOKEN=
MCP_HTTP_MAX_SESSIONS=20

# Optional runtime limits
MCP_CONNECT_TIMEOUT_MS=60000
MCP_MAX_CHAT_MESSAGES=200
